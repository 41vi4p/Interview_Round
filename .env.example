# Used only by `docker compose build` to pass the Next.js public Firebase
# config in as build args (NEXT_PUBLIC_* vars are inlined into the client
# bundle at build time, so they can't be plain runtime env vars in Docker).
# Same values as frontend/.env.local — safe to duplicate, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
